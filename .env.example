# API
CORS_ORIGINS=*
REALTIME_DB_PATH=logs/realtime.db
LOG_FILE=logs/app.log

# Database
DATABASE_URL=sqlite:///logs/realtime.db
# DATABASE_URL=postgresql+psycopg2://nlp_user:nlp_password@localhost:5432/nlp_platform

# Cache
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# LLM providers, checked in order
LLM_PROVIDER_ORDER=groq,openai,ollama,fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Optional heavyweight local model loading
CAPSTONE_ENABLE_SENTENCE_TRANSFORMERS=0
CAPSTONE_ENABLE_SPACY=0

